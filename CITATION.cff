    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.20"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/camt053-mcp"
url: "https://sebastienrousseau.github.io/camt053/"
keywords:
  - ISO 20022
  - camt.053
  - camt.052
  - bank statements
  - Model Context Protocol
  - MCP
  - AI agents
