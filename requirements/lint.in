camt053>=0.0.23,<1
camt053-loader-mt940>=0.0.23
camt053-loader-mt942>=0.0.23
ruff==0.17.1
black==26.10.1
mypy>=1.11,<3.0
pyjwt[crypto]>=2.15.1,<3
httpx>=0.27,<1
prometheus-client>=0.20,<2
urllib3>=2.8.0
